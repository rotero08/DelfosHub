# Response headers for every page and file. Cloudflare reads this file when it serves the
# site as static assets on Workers; no code has to run for these to apply.
#
# The Content-Security-Policy line below holds only the directives written by hand. The
# build (scripts/write-headers.mjs) extends it in dist/_headers with the rest of the policy,
# which carries hashes that change with the content (see `security` in astro.config.mjs).

/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Files under /_astro/ have a fingerprint in their name, so they can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
