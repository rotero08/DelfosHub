---
// The bar across the top, plus the full-screen menu it opens on small screens.
import Menu from './Menu.astro';
import { homeOf, sections, ui, type Locale, type Section } from '../i18n/ui';

interface Props {
	lang: Locale;
	/** On the home page the bar starts clear and fills in once the hero scrolls away. */
	overHero?: boolean;
	counts?: Partial<Record<Section, number>>;
}

const { lang, overHero = false, counts } = Astro.props;
const t = ui[lang];
// Section links are plain anchors on the home page and full addresses anywhere else.
const home = overHero ? '' : homeOf(lang);
const other: Locale = lang === 'en' ? 'es' : 'en';
const short: Partial<Record<Section, string>> = t.navShort;
---

<header class:list={['bar', { 'over-hero': overHero }]}>
	<div class="wrap bar-in">
		<a class="brand" href={home || '#top'} aria-label={t.home} data-track="brand">
			<span class="wordmark" aria-hidden="true">Delfos<span class="wordmark-t">T</span></span>
		</a>

		<nav class="links" aria-label={t.sectionsLabel}>
			{
				sections.map((id) => (
					<a href={`${home}#${id}`} data-track={`nav:${id}`}>
						{short[id] ?? t.nav[id]}
					</a>
				))
			}
		</nav>

		<div class="tools">
			<a
				class="tool lang"
				href={homeOf(other)}
				hreflang={other}
				lang={other}
				aria-label={`${other.toUpperCase()}, ${t.otherLangLabel}`}
				data-track={`lang:${other}`}
			>
				{other.toUpperCase()}
			</a>

			<label class="tool theme" data-track="theme">
				<input id="theme-switch" class="sr-only" type="checkbox" role="switch" aria-label={t.themeSwitch} />
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
				</svg>
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5"></circle>
					<path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
				</svg>
			</label>

			<button class="tool open" type="button" popovertarget="menu" data-track="menu-open">{t.menu}</button>
		</div>
	</div>
</header>

<div id="menu" class="overlay" popover>
	<div class="wrap overlay-in">
		<div class="overlay-top">
			<span class="label">{t.menu}</span>
			<button class="tool" type="button" popovertarget="menu" popovertargetaction="hide">{t.close}</button>
		</div>
		<nav aria-label={t.menu}>
			<Menu lang={lang} where="overlay" counts={counts} home={home} />
		</nav>
	</div>
</div>

<style>
	.bar {
		position: sticky;
		top: 0;
		z-index: 20;
		height: var(--bar);
		background: color-mix(in srgb, var(--bg) 86%, transparent);
		border-bottom: 1px solid var(--line);
		backdrop-filter: blur(12px);
	}

	.bar-in {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}

	.brand {
		margin-right: auto;
		font-size: 1.7rem;
		text-decoration: none;
	}

	.links {
		display: none;
		gap: 0.2rem;
	}

	.links a,
	.tool {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		line-height: 1;
		text-transform: uppercase;
		text-decoration: none;
	}

	.links a {
		padding: 0.6rem 0.75rem 0.5rem;
		color: var(--muted);
		clip-path: polygon(0 0, 100% 0, calc(100% - 0.4rem) 100%, 0 100%);
		transition:
			background-color 0.12s,
			color 0.12s;
	}

	.links a:hover,
	.links a:focus-visible {
		background: var(--slab);
		color: var(--on-slab);
	}

	.tools {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	/* Every control in the bar is at least 44px tall and wide: comfortable for a thumb. */
	.tool {
		display: inline-grid;
		place-items: center;
		min-width: 2.75rem;
		height: 2.75rem;
		padding: 0.1rem 0.7rem 0;
		border: 1px solid var(--line);
		background: none;
		color: var(--text);
		cursor: pointer;
		transition:
			background-color 0.12s,
			color 0.12s,
			border-color 0.12s;
	}

	.tool:hover {
		background: var(--slab);
		border-color: var(--slab);
		color: var(--on-slab);
	}

	.theme {
		padding: 0;
	}

	.theme:has(:focus-visible) {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	.theme svg {
		grid-area: 1 / 1;
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Night shows the moon, day shows the sun. */
	.sun {
		display: none;
	}

	:global(:root[data-theme='light']) .moon,
	:global(:root:not([data-theme]):has(#theme-switch:checked)) .moon {
		display: none;
	}

	:global(:root[data-theme='light']) .sun,
	:global(:root:not([data-theme]):has(#theme-switch:checked)) .sun {
		display: block;
	}

	/* ---------- Overlay menu (small screens) ---------- */
	.overlay {
		inset: 0;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: var(--bg);
		color: var(--text);
		overflow-y: auto;
	}

	.overlay-in {
		padding-block: 0.4rem 2rem;
	}

	.overlay-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--bar);
		margin-bottom: 1rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.overlay {
			opacity: 0;
			transform: translateY(-0.75rem);
			transition:
				opacity 0.18s,
				transform 0.18s var(--snap),
				display 0.18s allow-discrete,
				overlay 0.18s allow-discrete;
		}

		.overlay:popover-open {
			opacity: 1;
			transform: none;
		}

		@starting-style {
			.overlay:popover-open {
				opacity: 0;
				transform: translateY(-0.75rem);
			}
		}
	}

	/* ---------- Wide screens: links in the bar, no overlay ---------- */
	@media (min-width: 56rem) {
		.links {
			display: flex;
		}

		.open {
			display: none;
		}

		.brand {
			margin-right: 1rem;
		}

		.tools {
			margin-left: auto;
		}
	}

	/* On the home page the hero already shows the name and the menu, so at the top of the
	   page the bar keeps only its controls and fills in as the hero scrolls away. Browsers
	   without scroll-driven animations simply show the full bar from the start. */
	@supports (animation-timeline: scroll()) {
		.over-hero {
			animation: bar-fill linear both;
		}

		.over-hero :is(.brand, .links) {
			animation: bar-reveal linear both;
		}

		/* Kept apart from the two rules above on purpose. Written together, the CSS minifier
		   folds the timeline into the `animation` shorthand, which browsers then reject. */
		header.over-hero,
		header.over-hero :is(.brand, .links) {
			animation-timeline: scroll(root);
			animation-range: 30vh 55vh;
		}
	}

	@keyframes bar-fill {
		from {
			background-color: transparent;
			border-bottom-color: transparent;
			backdrop-filter: none;
		}
	}

	@keyframes bar-reveal {
		from {
			opacity: 0;
			visibility: hidden;
		}
	}
</style>
