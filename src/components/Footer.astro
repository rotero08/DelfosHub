---
import site from '../../site.config.mjs';
import { homeOf, ui, type Locale } from '../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Locale = lang === 'en' ? 'es' : 'en';
const counting = Boolean(site.analytics.clickEndpoint || site.analytics.cloudflareBeaconToken);
---

<footer class="foot">
	<div class="wrap foot-in">
		<p class="mark">
			<span class="wordmark" aria-hidden="true">Delfos<span class="wordmark-t">T</span></span>
			<span class="sr-only">{site.name}</span>
		</p>
		<p class="note">
			{`${t.colophon} ${counting ? t.privacyOn : t.privacyOff}`}
			<span class="curse">{t.curse}</span>
		</p>
		<p class="links">
			<a href={homeOf(other)} hreflang={other} lang={other} data-track={`lang-footer:${other}`}>{t.otherLang}</a>
			<a class="surface" href="#top" data-track="to-top">
				<svg class="lantern" viewBox="0 0 16 22" aria-hidden="true">
					<path class="frame" d="M8 1v3M5 4h6l1.4 3v9L11 19H5l-1.4-3V7z"></path>
					<path class="flame" d="M8 8.2c2.1 2 2.2 4.1 0 6.1-2.2-2-2.1-4.1 0-6.1z"></path>
				</svg>
				{t.toTop}
			</a>
		</p>
	</div>
</footer>

<style>
	.foot {
		margin-top: clamp(2rem, 6vw, 4rem);
		border-top: 1px solid var(--line);
	}

	.foot-in {
		display: grid;
		gap: 0.9rem;
		padding-block: 2.25rem 2.75rem;
	}

	.mark {
		font-size: 2rem;
	}

	.note {
		font-size: 1rem;
		color: var(--muted);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
	}

	.curse {
		display: block;
		font-style: italic;
	}

	.surface {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.lantern {
		width: 0.85rem;
		height: 1.15rem;
	}

	.lantern .frame {
		fill: none;
		stroke: var(--text);
		stroke-width: 1.4;
		stroke-linejoin: round;
		stroke-linecap: round;
	}

	.lantern .flame {
		fill: var(--mana);
	}

	@media (prefers-reduced-motion: no-preference) {
		.lantern .flame {
			transform-box: fill-box;
			transform-origin: 50% 100%;
			animation: flicker 3.2s ease-in-out infinite;
		}

		@keyframes flicker {
			50% {
				transform: scale(0.88, 1.08);
			}
		}
	}

	.links a {
		padding-block: 0.6rem;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}

	@media (min-width: 48rem) {
		.foot-in {
			grid-template-columns: auto 1fr auto;
			align-items: center;
			gap: 2rem;
		}
	}
</style>
