---
// Experience: a short path on one side, skills and languages on the other.
import SectionHead from './SectionHead.astro';
import { getExperience } from '../lib/content';
import { ui, type Locale } from '../i18n/ui';

interface Props {
	lang: Locale;
	no: number;
}

const { lang, no } = Astro.props;
const t = ui[lang];
const xp = await getExperience();
---

<section class="section wrap" id="experience">
	<SectionHead lang={lang} section="experience" no={no} title={t.nav.experience} hint={xp.note[lang]} />

	<div class="cols">
		<div>
			<h3 class="label">{t.timeline}</h3>
			<ol class="path">
				{
					xp.timeline.map((step) => (
						<li>
							<span class="when">{step.when[lang]}</span>
							<span class="stop" aria-hidden="true" />
							<div>
								<p class="role">{step.role[lang]}</p>
								<p class="detail">{step.detail[lang]}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>

		<div class="side">
			<div>
				<h3 class="label">{t.focus}</h3>
				<p class="focus">{xp.focus[lang]}</p>
			</div>

			<div>
				<h3 class="label">{t.skills}</h3>
				<dl class="skills">
					{
						xp.skills.map((group) => (
							<div>
								<dt>{group.name[lang]}</dt>
								<dd>
									<ul class="tags">
										{group.items.map((item) => (
											<li class="tag">{item}</li>
										))}
									</ul>
								</dd>
							</div>
						))
					}
				</dl>
			</div>

			<div>
				<h3 class="label">{t.languages}</h3>
				<ul class="langs">
					{
						xp.languages.map((l) => (
							<li>
								<span class="lname">{l.name[lang]}</span>
								<span class="pips" role="img" aria-label={t.rank.replace('{n}', String(l.rank))}>
									{[1, 2, 3, 4, 5].map((n) => (
										<span class:list={['pip', { on: n <= l.rank }]} />
									))}
								</span>
								<span class="level">{l.level[lang]}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.cols {
		display: grid;
		gap: 2.75rem;
	}

	.label {
		margin-bottom: 0.9rem;
	}

	/* ---------- Path: a road with a stop for each step ---------- */
	.path {
		display: grid;
	}

	.path li {
		display: grid;
		grid-template-columns: 5.2rem 1.4rem 1fr;
		gap: 0.4rem 0.7rem;
		padding-bottom: 1.5rem;
	}

	.path li:last-child {
		padding-bottom: 0;
	}

	.stop {
		position: relative;
		align-self: stretch;
		background: linear-gradient(var(--line), var(--line)) center top / 2px 100% no-repeat;
	}

	/* The road starts at the first stop and ends at the last. */
	.path li:first-child .stop {
		background-position: center 0.7rem;
		background-size: 2px calc(100% - 0.7rem);
	}

	.path li:last-child .stop {
		background-size: 2px 0.7rem;
	}

	.stop::before {
		content: '';
		position: absolute;
		top: 0.4rem;
		left: 50%;
		width: 0.8rem;
		height: 0.8rem;
		background: var(--mana);
		transform: translateX(-50%) rotate(45deg);
	}

	.when {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-style: italic;
		font-weight: 800;
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--accent);
	}

	.role {
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.detail {
		margin-top: 0.2rem;
		font-size: 1.02rem;
		line-height: 1.45;
		color: var(--muted);
		text-wrap: pretty;
	}

	/* ---------- Side ---------- */
	.side {
		display: grid;
		align-content: start;
		gap: 2rem;
	}

	.focus {
		padding-left: 1rem;
		border-left: 3px solid var(--mana);
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.skills {
		display: grid;
		gap: 0.85rem;
	}

	.skills > div {
		display: grid;
		grid-template-columns: 6.9rem 1fr;
		gap: 1rem;
		align-items: baseline;
	}

	dt {
		font-size: 1.02rem;
		font-weight: 600;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.langs {
		display: grid;
		gap: 0.35rem;
		max-width: 22rem;
	}

	.langs li {
		display: grid;
		grid-template-columns: 6.9rem auto 1fr;
		align-items: center;
		gap: 0.9rem;
		font-weight: 600;
	}

	/* Five diamonds: filled up to the level. */
	.pips {
		display: inline-flex;
		gap: 0.28rem;
	}

	.pip {
		width: 0.72rem;
		height: 0.72rem;
		background: var(--line);
		clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
	}

	.pip.on {
		background: var(--mana);
	}

	.level {
		font-size: 1rem;
		font-weight: 400;
		color: var(--muted);
	}

	@media (min-width: 58rem) {
		.cols {
			grid-template-columns: 1fr 1fr;
			gap: clamp(2.5rem, 6vw, 5rem);
		}
	}
</style>
