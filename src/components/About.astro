---
// About: a few human paragraphs and, when one is set, a way to get in touch.
import SectionHead from './SectionHead.astro';
import { getAbout } from '../lib/content';
import { ui, type Locale } from '../i18n/ui';

interface Props {
	lang: Locale;
	no: number;
}

const { lang, no } = Astro.props;
const t = ui[lang];
const { Content, contact, contactUrl, contactLabel } = await getAbout(lang);
---

<section class="section wrap" id="about">
	<SectionHead no={no} title={t.nav.about} hint={t.hint.about} />

	<div class="cols">
		<div class="prose">
			<Content />
		</div>

		{
			(contact || contactUrl) && (
				<aside class="contact">
					<h3 class="label">{t.contact}</h3>
					{contact && <p>{contact}</p>}
					{contactUrl && (
						<a class="button" href={contactUrl} data-track="contact">
							{contactLabel || t.contact}
						</a>
					)}
				</aside>
			)
		}
	</div>
</section>

<style>
	.cols {
		display: grid;
		gap: 2.5rem;
	}

	.prose {
		max-width: 38rem;
		font-size: 1.2rem;
		line-height: 1.6;
	}

	.prose :global(p + p) {
		margin-top: 1.1em;
	}

	/* The opening paragraph speaks a little louder. */
	.prose :global(p:first-child) {
		font-size: 1.4rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.prose :global(a) {
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
	}

	.contact {
		align-self: start;
		display: grid;
		gap: 0.8rem;
		padding: 1.3rem 1.4rem;
		border: 1px solid var(--line);
		background: var(--surface);
	}

	.contact p {
		font-size: 1.05rem;
		color: var(--muted);
		text-wrap: pretty;
	}

	.button {
		justify-self: start;
		padding: 0.7rem 1.5rem 0.6rem 1.1rem;
		background: var(--slab);
		color: var(--on-slab);
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		text-decoration: none;
		clip-path: polygon(0 0, 100% 0, calc(100% - 0.7rem) 100%, 0 100%);
	}

	.button:hover,
	.button:focus-visible {
		background: var(--accent);
		color: var(--on-accent);
	}

	@media (min-width: 58rem) {
		.cols {
			grid-template-columns: 1.6fr 1fr;
			gap: clamp(2.5rem, 6vw, 5rem);
		}
	}
</style>
