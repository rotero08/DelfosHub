---
// The first screen: the name, one line about it, and the command menu, above a small scene.
// The scene is a crossroads signpost against a rising moon (or sun, in the day theme), with
// one painted arm per project and a bare arm for whatever comes next.
import Menu from './Menu.astro';
import { ui, type Locale, type Section } from '../i18n/ui';

interface Props {
	lang: Locale;
	counts: Partial<Record<Section, number>>;
	/** Project colours, in order. They paint the arms of the signpost. */
	colors: string[];
}

const { lang, counts, colors } = Astro.props;
const t = ui[lang];

// Arms alternate sides going down the post. The last one is left unpainted.
const arms = [...colors.slice(0, 3), null].map((color, i) => {
	const y = 22 + i * 27;
	const right = i % 2 === 0;
	const reach = 46 - i * 4;
	const points = right
		? `63,${y} ${63 + reach},${y} ${75 + reach},${y + 10} ${63 + reach},${y + 20} 63,${y + 20}`
		: `57,${y} ${57 - reach},${y} ${45 - reach},${y + 10} ${57 - reach},${y + 20} 57,${y + 20}`;
	return { color, points, turn: `rotate(${right ? -3 : 4} 60 ${y + 10})` };
});

// The seal over the moon: twenty-four ticks round the outer rings, as [x1, y1, x2, y2].
const ticks = Array.from({ length: 24 }, (_, i) => {
	const a = (i * Math.PI) / 12;
	const inner = 91;
	const outer = i % 2 ? 94.5 : 97;
	return [inner * Math.cos(a), inner * Math.sin(a), outer * Math.cos(a), outer * Math.sin(a)].map((n) => +n.toFixed(2));
});

// The flower field along the ground, in the project colours and cream. A small seeded generator
// keeps the field the same on every build. [x, y, size, colour or null for cream]
let seed = 7;
const next = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const palette = [...colors.slice(0, 3), null];
const flowers = Array.from({ length: 34 }, (_, i) => {
	const y = 30 + next() * 26;
	const size = 7 + ((y - 30) / 26) * 7;
	return [+(8 + (i / 34) * 984 + (next() - 0.5) * 22).toFixed(1), +y.toFixed(1), +size.toFixed(1), palette[Math.floor(next() * palette.length)]] as const;
}).sort((a, b) => a[1] - b[1]);

// Petals and sparks of mana that drift up out of the field: [x, y, gold?]
const motes = Array.from({ length: 12 }, (_, i) => [+(40 + i * 78 + next() * 40).toFixed(0), +(150 + next() * 120).toFixed(0), i % 3 === 0] as const);

// Four-point sparkles in the strip of sky behind the scene: [x %, y %, size in px].
const stars = [
	[4, 12, 7],
	[13, 24, 4],
	[24, 6, 5],
	[37, 17, 8],
	[48, 7, 4],
	[58, 31, 5],
	[66, 12, 9],
	[75, 46, 4],
	[88, 8, 6],
	[95, 36, 8],
	[97, 60, 4],
	[54, 53, 3],
];
---

<section class="hero" id="top">
	<div class="wrap hero-in">
		<div class="intro">
			<p class="label">{t.eyebrow}</p>
			<h1 class="name">
				<span class="wordmark" aria-hidden="true">Delfos<span class="wordmark-t">T</span></span>
				<span class="sr-only">DelfosT</span>
			</h1>
			<p class="tagline">{t.tagline}</p>
			<p class="about">{t.intro}</p>
		</div>

		<nav class="index" aria-label={t.indexLabel}>
			<Menu lang={lang} where="hero" counts={counts} />
			{/* The menu really works this way; the line only says so. */}
			<p class="prompts" aria-hidden="true">
				<span><kbd class="keycap">↑</kbd> <kbd class="keycap">↓</kbd> {t.keys.move}</span>
				<span><kbd class="keycap">↵</kbd> {t.keys.open}</span>
				<span><kbd class="keycap">1</kbd>–<kbd class="keycap">5</kbd> {t.keys.jump}</span>
			</p>
		</nav>
	</div>

	<div class="scene" aria-hidden="true">
		{/* Positions are SVG attributes because the security policy forbids style attributes. */}
		<svg class="stars">
			{
				stars.map(([x, y, size]) => (
					<svg x={`${x}%`} y={`${y}%`} width={size * 2} height={size * 2} viewBox="-1 -1 2 2">
						<path d="M0-1Q.12-.12 1 0 .12.12 0 1-.12.12-1 0-.12-.12 0-1Z" />
					</svg>
				))
			}
		</svg>
		<div class="orb"></div>
		<svg class="seal" viewBox="-100 -100 200 200">
			<g class="outer">
				<circle r="98" class="ring-a"></circle>
				<circle r="89" class="ring-a dashed"></circle>
				{ticks.map(([x1, y1, x2, y2]) => <line class="ring-a" x1={x1} y1={y1} x2={x2} y2={y2}></line>)}
			</g>
			<g class="inner">
				<circle r="62" class="ring-b"></circle>
				<polygon class="ring-b" points="43.8,43.8 -43.8,43.8 -43.8,-43.8 43.8,-43.8"></polygon>
				<polygon class="ring-b" points="62,0 0,62 -62,0 0,-62"></polygon>
				<circle r="36" class="ring-b"></circle>
				<circle r="3" class="dot"></circle>
			</g>
		</svg>
		<svg class="ridges" viewBox="0 0 1000 100" preserveAspectRatio="none">
			<polygon
				class="far"
				points="0,62 60,50 110,58 190,36 240,48 300,30 360,52 430,42 500,60 560,70 640,75 720,70 800,74 880,68 930,58 1000,46 1000,100 0,100"
			></polygon>
			<polygon
				class="mid"
				points="0,78 80,70 170,80 260,66 340,78 420,72 520,84 620,82 700,87 790,82 880,86 950,78 1000,74 1000,100 0,100"
			></polygon>
			<polygon class="ground" points="0,92 150,89 320,93 520,90 700,93 860,90 1000,92 1000,100 0,100"></polygon>
		</svg>
		<svg class="field" viewBox="0 0 1000 60" preserveAspectRatio="xMidYMax slice">
			<defs>
				<symbol id="flower" viewBox="-5 -5 10 15">
					<path class="stem" d="M0 2V10"></path>
					<g class="petals">
						{[0, 72, 144, 216, 288].map((turn) => <ellipse cx="0" cy="-2.3" rx="1.6" ry="2.7" transform={`rotate(${turn})`}></ellipse>)}
					</g>
					<circle class="heart" r="1.15"></circle>
				</symbol>
			</defs>
			{
				flowers.map(([x, y, size, color]) => (
					<use href="#flower" x={x - size / 2} y={y - size} width={size} height={size * 1.5} fill={color ?? undefined} class={color ? undefined : 'cream'}></use>
				))
			}
		</svg>
		<svg class="motes" viewBox="0 0 1000 300" preserveAspectRatio="xMidYMax slice">
			{
				motes.map(([x, y, gold]) => (
					<g transform={`translate(${x} ${y})`}>
						<path class={gold ? 'mote gold' : 'mote'} d="M0-4.5Q3-1.5 0 4.5-3-1.5 0-4.5Z"></path>
					</g>
				))
			}
		</svg>
		<svg class="post" viewBox="0 0 120 150">
			<path class="pole" d="M56,150V14l4-8 4,8v136Z"></path>
			{
				arms.map(({ color, points, turn }) => (
					<polygon class:list={['arm', { bare: !color }]} points={points} transform={turn} fill={color ?? undefined} />
				))
			}
		</svg>
	</div>
</section>

<style>
	.hero {
		--scene: clamp(11rem, 32vh, 19rem);
		--orb-size: calc(var(--scene) * 0.92);
		--orb-right: clamp(1.5rem, 13vw, 14rem);

		position: relative;
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100svh;
		/* The bar is sticky and sits above the hero's first rows. */
		margin-top: calc(-1 * var(--bar));
		padding-top: var(--bar);
		background: linear-gradient(var(--sky-a) 30%, var(--sky-b));
		overflow: hidden;
	}

	.hero-in {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 2rem;
		align-content: center;
		padding-block: clamp(1.5rem, 5vh, 3.5rem) 1.5rem;
	}

	.name {
		margin: 0.6rem 0 1.4rem;
		line-height: 0.9;
		font-size: clamp(4.6rem, 2.4rem + 11vw, 10.5rem);
	}

	.tagline {
		font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.95rem);
		font-weight: 500;
		line-height: 1.2;
		text-wrap: balance;
	}

	.about {
		max-width: 34rem;
		margin-top: 0.8rem;
		color: var(--muted);
		text-wrap: pretty;
	}

	.index {
		/* Rows reach a little past the text column so their numbers line up with it. */
		margin-inline: -0.7rem;
	}

	/* ---------- Scene ---------- */
	.scene {
		position: relative;
		height: var(--scene);
	}

	.stars {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		fill: var(--star);
		opacity: 0.8;
	}

	.orb {
		position: absolute;
		right: var(--orb-right);
		bottom: calc(var(--scene) * 0.1);
		width: var(--orb-size);
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--orb);
		box-shadow: 0 0 calc(var(--scene) * 0.5) var(--orb-glow);
	}

	.ridges {
		position: absolute;
		inset: auto 0 0;
		width: 100%;
		height: 100%;
	}

	/* A seal engraved over the moon: dark linework on the light disc, accent linework on the sky. */
	.seal {
		--seal: calc(var(--orb-size) * 1.4);

		position: absolute;
		right: calc(var(--orb-right) + var(--orb-size) * 0.5 - var(--seal) * 0.5);
		bottom: calc(var(--scene) * 0.1 + var(--orb-size) * 0.5 - var(--seal) * 0.5);
		width: var(--seal);
		height: var(--seal);
		fill: none;
		pointer-events: none;
	}

	.ring-a {
		stroke: var(--accent);
		stroke-width: 0.7;
		opacity: 0.55;
	}

	.ring-a.dashed {
		stroke-dasharray: 1.2 4.2;
		stroke-width: 1.1;
	}

	.ring-b {
		stroke: var(--silhouette);
		stroke-width: 0.7;
		opacity: 0.3;
	}

	.dot {
		fill: var(--silhouette);
		opacity: 0.35;
	}

	.outer,
	.inner {
		transform-origin: center;
	}

	/* The flower field: blooms in the colours of the projects stand along the ground. */
	.field {
		position: absolute;
		inset: auto 0 0;
		width: 100%;
		height: calc(var(--scene) * 0.32);
		overflow: visible;
	}

	.field .stem {
		fill: none;
		stroke: var(--ridge-mid);
		stroke-width: 0.5;
	}

	.field .petals {
		fill: inherit;
	}

	.field .cream {
		fill: var(--text);
	}

	.field .heart {
		fill: var(--mana);
	}

	.motes {
		position: absolute;
		inset: auto 0 0;
		width: 100%;
		height: calc(var(--scene) * 1.1);
		pointer-events: none;
	}

	.mote {
		fill: var(--petal);
		opacity: 0;
		transform-box: fill-box;
		transform-origin: center;
	}

	.mote.gold {
		fill: var(--mana);
	}

	.prompts {
		display: none;
		gap: 1.4rem;
		margin: 1.1rem 0.7rem 0;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.prompts span {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
	}

	@media (hover: hover) and (min-width: 62rem) {
		.prompts {
			display: flex;
		}
	}

	.far {
		fill: var(--ridge-far);
	}

	.mid {
		fill: var(--ridge-mid);
	}

	.ground {
		fill: var(--bg);
	}

	.post {
		position: absolute;
		/* Stands a little left of the orb's centre, planted in the ground strip. */
		right: calc(var(--orb-right) + var(--orb-size) * 0.5 - var(--scene) * 0.19);
		bottom: calc(var(--scene) * 0.05);
		height: calc(var(--scene) * 0.66);
		overflow: visible;
	}

	.pole {
		fill: var(--silhouette);
	}

	.arm {
		stroke: var(--silhouette);
		stroke-width: 3.5;
		stroke-linejoin: round;
	}

	.arm.bare {
		fill: var(--ridge-mid);
	}

	@media (min-width: 62rem) {
		.hero-in {
			grid-template-columns: 5fr 6fr;
			align-items: center;
			gap: clamp(2rem, 5vw, 5rem);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.orb {
			animation: rise 1.1s var(--snap) both;
		}

		@keyframes rise {
			from {
				transform: translateY(35%);
			}
		}

		.outer {
			animation: turn 160s linear infinite;
		}

		.inner {
			animation: turn 110s linear infinite reverse;
		}

		@keyframes turn {
			to {
				transform: rotate(360deg);
			}
		}

		/* Petals and sparks lift out of the field, sway, and fade. Each one runs on its own clock. */
		.mote {
			animation: drift 9s ease-in infinite;
		}

		.motes g:nth-child(2n) .mote {
			animation-duration: 12s;
			animation-delay: -4s;
		}

		.motes g:nth-child(3n) .mote {
			animation-duration: 10.5s;
			animation-delay: -7s;
		}

		.motes g:nth-child(5n) .mote {
			animation-duration: 14s;
			animation-delay: -2s;
		}

		@keyframes drift {
			0% {
				opacity: 0;
				transform: translate(0, 0) rotate(0);
			}
			12% {
				opacity: 0.85;
			}
			55% {
				transform: translate(18px, -90px) rotate(140deg);
			}
			100% {
				opacity: 0;
				transform: translate(-6px, -190px) rotate(300deg);
			}
		}
	}
</style>
